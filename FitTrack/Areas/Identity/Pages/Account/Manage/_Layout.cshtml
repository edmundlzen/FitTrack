@{
    Layout = "/Views/Shared/_Layout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
    <div>
        <div class="ft-h1">Account Settings</div>
        <div class="ft-muted mt-1">Manage your login credentials and account security.</div>
    </div>
</div>

<div class="row g-4">
    <div class="col-md-3">
        <div class="card">
            <div class="card-body p-2">
                <nav class="d-flex flex-column gap-1">
                    @{
                        var page = ViewContext.RouteData.Values["page"]?.ToString() ?? "";
                        string NavClass(string p) => page.EndsWith(p, StringComparison.OrdinalIgnoreCase)
                            ? "ft-nav-item active" : "ft-nav-item";
                    }
                    <a asp-area="Identity" asp-page="/Account/Manage/Index"
                       class="@NavClass("Index")" style="color:inherit;border-radius:8px;">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                        Profile
                    </a>
                    <a asp-area="Identity" asp-page="/Account/Manage/ChangePassword"
                       class="@NavClass("ChangePassword")" style="color:inherit;border-radius:8px;">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                        Password
                    </a>
                    <a asp-area="Identity" asp-page="/Account/Manage/PersonalData"
                       class="@NavClass("PersonalData")" style="color:inherit;border-radius:8px;">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
                        Personal data
                    </a>
                </nav>
            </div>
        </div>
    </div>
    <div class="col-md-9">
        @RenderBody()
    </div>
</div>

@await RenderSectionAsync("Scripts", required: false)
