@page
@model FitTrack.Areas.Identity.Pages.Account.Manage.IndexModel
@{
    ViewData["Title"] = "Account Settings";
    Layout = "~/Areas/Identity/Pages/Account/Manage/_Layout.cshtml";
}

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    var isError = Model.StatusMessage.StartsWith("Error");
    <div class="alert @(isError ? "alert-danger" : "alert-success") alert-dismissible fade show mb-3" role="alert">
        @Model.StatusMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card">
    <div class="card-header"><div class="ft-h2">Profile</div></div>
    <div class="card-body">
        <form method="post">
            <div class="mb-3">
                <label class="form-label">Username</label>
                <input type="text" class="form-control" value="@Model.Username" disabled />
                <div class="form-text">Your username cannot be changed here. Update it from your <a asp-controller="UserProfile" asp-action="Index" style="color:var(--ft-teal)">profile page</a>.</div>
            </div>
            <div class="mb-4">
                <label asp-for="Input.PhoneNumber" class="form-label">Phone number</label>
                <input asp-for="Input.PhoneNumber" class="form-control" placeholder="+1 555 000 0000" />
                <span asp-validation-for="Input.PhoneNumber" class="text-danger small"></span>
            </div>
            <button type="submit" class="btn btn-primary">Save changes</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
