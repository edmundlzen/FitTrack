@page
@model FitTrack.Areas.Identity.Pages.Account.ResetPasswordConfirmationModel
@{
    ViewData["Title"] = "Password reset";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<div class="auth-card" style="text-align:center;">
    <div class="auth-brand" style="justify-content:center;">
        <div class="auth-brand-mark">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M6.5 6.5v11M3 9v6M17.5 6.5v11M21 9v6M6.5 12h11"/></svg>
        </div>
        <span class="auth-brand-name">FitTrack</span>
    </div>

    <div style="width:56px;height:56px;border-radius:16px;background:rgba(0,191,165,.12);display:grid;place-items:center;margin:0 auto 20px;">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#00BFA5" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12l5 5 9-11"/>
        </svg>
    </div>

    <h1 class="auth-title">Password reset</h1>
    <p class="auth-sub" style="margin-bottom:28px;">Your password has been reset. You can now log in with your new password.</p>

    <a asp-area="Identity" asp-page="/Account/Login" class="auth-btn" style="display:block;text-align:center;text-decoration:none;">Log in</a>
</div>
