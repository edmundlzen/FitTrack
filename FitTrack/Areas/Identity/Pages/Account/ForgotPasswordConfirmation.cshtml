@page
@model FitTrack.Areas.Identity.Pages.Account.ForgotPasswordConfirmationModel
@{
    ViewData["Title"] = "Check your email";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<div class="auth-card" style="text-align:center;">
    <div class="auth-brand" style="justify-content:center;">
        <div class="auth-brand-mark">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M6.5 6.5v11M3 9v6M17.5 6.5v11M21 9v6M6.5 12h11"/></svg>
        </div>
        <span class="auth-brand-name">FitTrack</span>
    </div>

    <div style="width:56px;height:56px;border-radius:16px;background:rgba(0,191,165,.12);display:grid;place-items:center;margin:0 auto 20px;">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#00BFA5" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/>
        </svg>
    </div>

    <h1 class="auth-title">Check your email</h1>
    <p class="auth-sub" style="margin-bottom:28px;">If that address is registered, a password reset link is on its way. Check your spam folder if you don't see it.</p>

    <div class="auth-footer-links" style="border-top:none;margin-top:0;padding-top:0;">
        <a asp-area="Identity" asp-page="/Account/Login">Back to <strong>Log in</strong></a>
    </div>
</div>
