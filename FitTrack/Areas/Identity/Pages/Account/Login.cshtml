@page
@model FitTrack.Areas.Identity.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Log in";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<div class="auth-card">
    <div class="auth-brand">
        <div class="auth-brand-mark">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M6.5 6.5v11M3 9v6M17.5 6.5v11M21 9v6M6.5 12h11"/></svg>
        </div>
        <span class="auth-brand-name">FitTrack</span>
    </div>

    <h1 class="auth-title">Welcome back</h1>
    <p class="auth-sub">Log in to your account to continue training.</p>

    <form method="post" class="auth-form">
        <div asp-validation-summary="ModelOnly" class="auth-error" role="alert"></div>

        <div class="auth-field">
            <label asp-for="Input.Email">Email</label>
            <input asp-for="Input.Email" autocomplete="username" placeholder="you@example.com" />
            <span asp-validation-for="Input.Email" class="field-error"></span>
        </div>

        <div class="auth-field">
            <div class="field-label-row">
                <label asp-for="Input.Password">Password</label>
                <a asp-area="Identity" asp-page="/Account/ForgotPassword" class="forgot-link">Forgot password?</a>
            </div>
            <input asp-for="Input.Password" type="password" autocomplete="current-password" placeholder="••••••••" />
            <span asp-validation-for="Input.Password" class="field-error"></span>
        </div>

        <div class="auth-check">
            <input asp-for="Input.RememberMe" type="checkbox" id="remember" />
            <label for="remember">Keep me signed in</label>
        </div>

        <button type="submit" class="auth-btn">Log in</button>
    </form>

    <div class="auth-footer-links">
        <a asp-area="Identity" asp-page="/Account/Register" asp-route-returnUrl="@Model.ReturnUrl">Don't have an account? <strong>Sign up free</strong></a>
        <a asp-area="Identity" asp-page="/Account/ForgotPassword">Forgot your password?</a>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
