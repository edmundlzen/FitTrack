@page
@model FitTrack.Areas.Identity.Pages.Account.ForgotPasswordModel
@{
    ViewData["Title"] = "Reset password";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<div class="auth-card">
    <div class="auth-brand">
        <div class="auth-brand-mark">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M6.5 6.5v11M3 9v6M17.5 6.5v11M21 9v6M6.5 12h11"/></svg>
        </div>
        <span class="auth-brand-name">FitTrack</span>
    </div>

    <h1 class="auth-title">Reset your password</h1>
    <p class="auth-sub">Enter your email and we'll send you a reset link if an account exists.</p>

    <form method="post" class="auth-form">
        <div asp-validation-summary="ModelOnly" class="auth-error" role="alert"></div>

        <div class="auth-field">
            <label asp-for="Input.Email">Email</label>
            <input asp-for="Input.Email" autocomplete="username" placeholder="you@example.com" />
            <span asp-validation-for="Input.Email" class="field-error"></span>
        </div>

        <button type="submit" class="auth-btn">Send reset link</button>
    </form>

    <div class="auth-footer-links">
        <a asp-area="Identity" asp-page="/Account/Login">Back to <strong>Log in</strong></a>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
