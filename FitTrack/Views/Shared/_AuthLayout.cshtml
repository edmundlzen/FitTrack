<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — FitTrack</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <style>
        *, *::before, *::after { box-sizing: border-box; }
        body {
            margin: 0; padding: 0;
            font-family: 'Inter', ui-sans-serif, system-ui, sans-serif;
            -webkit-font-smoothing: antialiased;
            background: linear-gradient(135deg, #0A0F22 0%, #10173A 60%, #1A1F36 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 24px;
        }
        body::before {
            content: "";
            position: fixed;
            inset: 0;
            background:
                radial-gradient(600px 400px at 20% 20%, rgba(0,191,165,.15), transparent 60%),
                radial-gradient(500px 400px at 80% 80%, rgba(255,107,53,.12), transparent 60%);
            pointer-events: none;
        }
        .auth-card {
            position: relative;
            background: #fff;
            border-radius: 20px;
            padding: 40px;
            width: 100%;
            max-width: 420px;
            box-shadow: 0 32px 80px rgba(0,0,0,.4), 0 0 0 1px rgba(255,255,255,.06);
        }
        .auth-brand {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 28px;
        }
        .auth-brand-mark {
            width: 36px; height: 36px;
            border-radius: 10px;
            background: linear-gradient(135deg, #00BFA5, #06D6BC);
            display: grid;
            place-items: center;
            color: #0A1024;
            box-shadow: 0 6px 16px rgba(0,191,165,.35);
        }
        .auth-brand-name {
            font-weight: 800;
            font-size: 18px;
            letter-spacing: -.01em;
            color: #13182B;
        }
        .auth-title {
            font-size: 24px;
            font-weight: 800;
            letter-spacing: -.02em;
            color: #13182B;
            margin: 0 0 6px;
        }
        .auth-sub {
            font-size: 14px;
            color: #6B7390;
            margin: 0 0 28px;
            line-height: 1.5;
        }
        .auth-form {
            display: flex;
            flex-direction: column;
            gap: 16px;
        }
        .auth-error {
            background: rgba(239,68,68,.08);
            border: 1px solid rgba(239,68,68,.25);
            border-radius: 10px;
            padding: 12px 14px;
            font-size: 13.5px;
            color: #B91C1C;
            line-height: 1.5;
        }
        .auth-error:empty { display: none; }
        .auth-field {
            display: flex;
            flex-direction: column;
            gap: 6px;
        }
        .auth-field label {
            font-size: 13.5px;
            font-weight: 600;
            color: #3B4262;
        }
        .field-label-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .field-label-row label { margin: 0; }
        .forgot-link {
            font-size: 12.5px;
            color: #00BFA5;
            font-weight: 500;
            text-decoration: none;
        }
        .forgot-link { transition: color .18s cubic-bezier(0.4,0,0.2,1); }
        .forgot-link:hover { color: #00A892; }
        .auth-field input {
            width: 100%;
            padding: 11px 14px;
            border: 1.5px solid #E6E9F2;
            border-radius: 10px;
            font-family: inherit;
            font-size: 14.5px;
            color: #13182B;
            background: #FAFBFD;
            transition: border-color .18s cubic-bezier(0.4,0,0.2,1), box-shadow .18s cubic-bezier(0.4,0,0.2,1), background .18s cubic-bezier(0.4,0,0.2,1);
            outline: none;
        }
        .auth-field input:focus {
            border-color: #00BFA5;
            box-shadow: 0 0 0 3px rgba(0,191,165,.12);
            background: #fff;
        }
        .auth-field input::placeholder { color: #9AA2BD; }
        .field-error {
            font-size: 12px;
            color: #B91C1C;
            font-weight: 500;
        }
        .field-error:empty { display: none; }
        .auth-check {
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .auth-check input[type="checkbox"] {
            width: 16px;
            height: 16px;
            accent-color: #00BFA5;
            cursor: pointer;
        }
        .auth-check label {
            font-size: 13.5px;
            color: #3B4262;
            cursor: pointer;
        }
        .auth-btn {
            width: 100%;
            padding: 13px;
            background: #00BFA5;
            color: #fff;
            border: none;
            border-radius: 10px;
            font-family: inherit;
            font-size: 15px;
            font-weight: 700;
            letter-spacing: -.005em;
            cursor: pointer;
            transition: background .18s cubic-bezier(0.4,0,0.2,1), transform .06s cubic-bezier(0.4,0,0.2,1), box-shadow .18s cubic-bezier(0.4,0,0.2,1);
            margin-top: 4px;
        }
        .auth-btn:hover { background: #00A892; }
        .auth-btn:active { transform: translateY(1px); }
        .auth-footer-links {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 10px;
            margin-top: 24px;
            padding-top: 20px;
            border-top: 1px solid #EEF1F7;
        }
        .auth-footer-links a {
            font-size: 13.5px;
            color: #6B7390;
            text-decoration: none;
            transition: color .18s cubic-bezier(0.4,0,0.2,1);
        }
        .auth-footer-links a:hover { color: #13182B; }
        .auth-footer-links a strong {
            color: #00BFA5;
            font-weight: 600;
        }
        .auth-footer-links a:hover strong { color: #00A892; }
        .back-link {
            position: fixed;
            top: 20px;
            left: 24px;
            display: flex;
            align-items: center;
            gap: 6px;
            font-size: 13px;
            color: rgba(255,255,255,.6);
            text-decoration: none;
            font-weight: 500;
            transition: color .15s;
        }
        .back-link:hover { color: #fff; }
    </style>
</head>
<body>
    <a href="/" class="back-link">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M12 5l-7 7 7 7"/></svg>
        Back to home
    </a>
    @RenderBody()
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
