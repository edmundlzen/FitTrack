@model FitTrack.Models.UserProfile
@{
    ViewData["Title"] = "Edit Profile";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm border-0">
            <div class="card-header ft-card-header">
                <h4 class="mb-0 text-white">Edit Profile</h4>
            </div>
            <div class="card-body p-4">
                <form asp-action="Edit" enctype="multipart/form-data">
                    <input type="hidden" asp-for="UserProfileId" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="row g-3">
                        <div class="col-12">
                            <label asp-for="FullName" class="form-label fw-semibold"></label>
                            <input asp-for="FullName" class="form-control" />
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>
                        <div class="col-sm-6">
                            <label asp-for="Age" class="form-label fw-semibold"></label>
                            <input asp-for="Age" class="form-control" type="number" min="1" max="120" />
                            <span asp-validation-for="Age" class="text-danger small"></span>
                        </div>
                        <div class="col-sm-6">
                            <label asp-for="Gender" class="form-label fw-semibold"></label>
                            <select asp-for="Gender" class="form-select">
                                <option>Male</option>
                                <option>Female</option>
                                <option>Other</option>
                            </select>
                            <span asp-validation-for="Gender" class="text-danger small"></span>
                        </div>
                        <div class="col-sm-6">
                            <label asp-for="Height" class="form-label fw-semibold"></label>
                            <div class="input-group">
                                <input asp-for="Height" class="form-control" type="number" step="0.1" />
                                <span class="input-group-text">cm</span>
                            </div>
                            <span asp-validation-for="Height" class="text-danger small"></span>
                        </div>
                        <div class="col-sm-6">
                            <label asp-for="Weight" class="form-label fw-semibold"></label>
                            <div class="input-group">
                                <input asp-for="Weight" class="form-control" type="number" step="0.1" />
                                <span class="input-group-text">kg</span>
                            </div>
                            <span asp-validation-for="Weight" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold">Update Profile Picture</label>
                            @if (!string.IsNullOrEmpty(Model.ProfilePicture))
                            {
                                <div class="mb-2">
                                    <img src="~/uploads/@Model.ProfilePicture" alt="Current" class="rounded" style="height:60px;" />
                                    <span class="text-muted small ms-2">Current picture</span>
                                </div>
                            }
                            <input type="file" name="profilePicture" class="form-control" accept="image/*" />
                            <div class="form-text">Leave blank to keep current picture.</div>
                        </div>
                    </div>

                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn btn-primary px-4">Save Changes</button>
                        <a asp-action="Details" asp-route-id="@Model.UserProfileId" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
