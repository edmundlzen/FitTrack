@model FitTrack.Models.WorkoutSession
@{
    ViewData["Title"] = "Edit Workout";
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-8">
        <div class="card">
            <div class="card-header ft-card-header-dark">
                <div class="ft-h2" style="color:#fff;">Edit Workout</div>
            </div>
            <div class="card-body p-3 p-md-4">
                <form asp-action="Edit">
                    <input type="hidden" asp-for="WorkoutSessionId" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="row g-3">
                        <div class="col-12">
                            <label asp-for="WorkoutName" class="form-label"></label>
                            <input asp-for="WorkoutName" class="form-control" />
                            <span asp-validation-for="WorkoutName" class="text-danger small"></span>
                        </div>
                        <div class="col-6">
                            <label asp-for="Category" class="form-label"></label>
                            <select asp-for="Category" class="form-select">
                                <option>Cardio</option>
                                <option>Strength</option>
                                <option>Flexibility</option>
                            </select>
                            <span asp-validation-for="Category" class="text-danger small"></span>
                        </div>
                        <div class="col-6">
                            <label asp-for="SessionDate" class="form-label"></label>
                            <input asp-for="SessionDate" class="form-control" type="date" />
                            <span asp-validation-for="SessionDate" class="text-danger small"></span>
                        </div>
                        <div class="col-6">
                            <label asp-for="DurationMinutes" class="form-label"></label>
                            <div class="input-group">
                                <input asp-for="DurationMinutes" class="form-control" type="number" min="1" />
                                <span class="input-group-text">min</span>
                            </div>
                            <span asp-validation-for="DurationMinutes" class="text-danger small"></span>
                        </div>
                        <div class="col-6">
                            <label asp-for="CaloriesBurned" class="form-label"></label>
                            <div class="input-group">
                                <input asp-for="CaloriesBurned" class="form-control" type="number" min="0" />
                                <span class="input-group-text">kcal</span>
                            </div>
                            <span asp-validation-for="CaloriesBurned" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Notes" class="form-label"></label>
                            <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
                        </div>
                    </div>

                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn btn-primary flex-fill">Save Changes</button>
                        <a asp-action="Index" class="btn btn-outline-secondary flex-fill">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
