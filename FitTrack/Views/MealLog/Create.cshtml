@model FitTrack.Models.MealLog
@{
    ViewData["Title"] = "Log Meal";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm border-0">
            <div class="card-header ft-card-header">
                <h4 class="mb-0 text-white">Log New Meal</h4>
            </div>
            <div class="card-body p-4">
                <form asp-action="Create">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="row g-3">
                        <div class="col-sm-8">
                            <label asp-for="MealName" class="form-label fw-semibold"></label>
                            <input asp-for="MealName" class="form-control" placeholder="e.g. Grilled Chicken Salad" />
                            <span asp-validation-for="MealName" class="text-danger small"></span>
                        </div>
                        <div class="col-sm-4">
                            <label asp-for="MealType" class="form-label fw-semibold"></label>
                            <select asp-for="MealType" class="form-select">
                                <option value="">-- Select --</option>
                                <option>Breakfast</option>
                                <option>Lunch</option>
                                <option>Dinner</option>
                                <option>Snack</option>
                            </select>
                            <span asp-validation-for="MealType" class="text-danger small"></span>
                        </div>
                        <div class="col-sm-6">
                            <label asp-for="LogDate" class="form-label fw-semibold"></label>
                            <input asp-for="LogDate" class="form-control" type="date" />
                            <span asp-validation-for="LogDate" class="text-danger small"></span>
                        </div>
                        <div class="col-sm-6">
                            <label asp-for="Calories" class="form-label fw-semibold"></label>
                            <div class="input-group">
                                <input asp-for="Calories" class="form-control" type="number" min="0" />
                                <span class="input-group-text">kcal</span>
                            </div>
                            <span asp-validation-for="Calories" class="text-danger small"></span>
                        </div>

                        <div class="col-12"><hr class="my-1" /><p class="text-muted small mb-0">Macronutrients</p></div>

                        <div class="col-sm-4">
                            <label asp-for="Protein" class="form-label fw-semibold"></label>
                            <div class="input-group">
                                <input asp-for="Protein" class="form-control" type="number" step="0.1" min="0" />
                                <span class="input-group-text">g</span>
                            </div>
                            <span asp-validation-for="Protein" class="text-danger small"></span>
                        </div>
                        <div class="col-sm-4">
                            <label asp-for="Carbohydrates" class="form-label fw-semibold"></label>
                            <div class="input-group">
                                <input asp-for="Carbohydrates" class="form-control" type="number" step="0.1" min="0" />
                                <span class="input-group-text">g</span>
                            </div>
                            <span asp-validation-for="Carbohydrates" class="text-danger small"></span>
                        </div>
                        <div class="col-sm-4">
                            <label asp-for="Fats" class="form-label fw-semibold"></label>
                            <div class="input-group">
                                <input asp-for="Fats" class="form-control" type="number" step="0.1" min="0" />
                                <span class="input-group-text">g</span>
                            </div>
                            <span asp-validation-for="Fats" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Notes" class="form-label fw-semibold"></label>
                            <textarea asp-for="Notes" class="form-control" rows="2" placeholder="Optional notes..."></textarea>
                        </div>
                    </div>

                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn btn-primary px-4">Save Meal</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
