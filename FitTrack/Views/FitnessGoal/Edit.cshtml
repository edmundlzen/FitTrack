@model FitTrack.Models.FitnessGoal
@{
    ViewData["Title"] = "Edit Goal";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm border-0">
            <div class="card-header ft-card-header">
                <h4 class="mb-0 text-white">Edit Goal</h4>
            </div>
            <div class="card-body p-4">
                <form asp-action="Edit">
                    <input type="hidden" asp-for="FitnessGoalId" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="row g-3">
                        <div class="col-12">
                            <label asp-for="GoalTitle" class="form-label fw-semibold"></label>
                            <input asp-for="GoalTitle" class="form-control" />
                            <span asp-validation-for="GoalTitle" class="text-danger small"></span>
                        </div>
                        <div class="col-sm-6">
                            <label asp-for="GoalType" class="form-label fw-semibold"></label>
                            <select asp-for="GoalType" class="form-select">
                                <option>Weight Loss</option>
                                <option>Muscle Gain</option>
                                <option>Endurance</option>
                                <option>Flexibility</option>
                            </select>
                            <span asp-validation-for="GoalType" class="text-danger small"></span>
                        </div>
                        <div class="col-sm-6">
                            <label asp-for="Status" class="form-label fw-semibold"></label>
                            <select asp-for="Status" class="form-select">
                                <option>In Progress</option>
                                <option>Completed</option>
                                <option>Abandoned</option>
                            </select>
                        </div>
                        <div class="col-sm-6">
                            <label asp-for="TargetValue" class="form-label fw-semibold"></label>
                            <input asp-for="TargetValue" class="form-control" type="number" step="0.1" min="0" />
                            <span asp-validation-for="TargetValue" class="text-danger small"></span>
                        </div>
                        <div class="col-sm-6">
                            <label asp-for="CurrentValue" class="form-label fw-semibold"></label>
                            <input asp-for="CurrentValue" class="form-control" type="number" step="0.1" min="0" />
                            <span asp-validation-for="CurrentValue" class="text-danger small"></span>
                        </div>
                        <div class="col-sm-6">
                            <label asp-for="StartDate" class="form-label fw-semibold"></label>
                            <input asp-for="StartDate" class="form-control" type="date" />
                            <span asp-validation-for="StartDate" class="text-danger small"></span>
                        </div>
                        <div class="col-sm-6">
                            <label asp-for="TargetDate" class="form-label fw-semibold"></label>
                            <input asp-for="TargetDate" class="form-control" type="date" />
                            <span asp-validation-for="TargetDate" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Notes" class="form-label fw-semibold"></label>
                            <textarea asp-for="Notes" class="form-control" rows="2"></textarea>
                        </div>
                    </div>

                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn btn-primary px-4">Save Changes</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
