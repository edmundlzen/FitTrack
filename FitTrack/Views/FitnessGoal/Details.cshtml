@model FitTrack.Models.FitnessGoal
@{
    ViewData["Title"] = "Goal Details";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm border-0">
            <div class="card-header ft-card-header d-flex justify-content-between align-items-center">
                <h4 class="mb-0 text-white">@Model.GoalTitle</h4>
                <span class="badge @Model.StatusBadgeClass fs-6">@Model.Status</span>
            </div>
            <div class="card-body p-4">
                <!-- Progress Bar -->
                <div class="mb-4">
                    <div class="d-flex justify-content-between mb-1">
                        <span class="fw-semibold">Progress</span>
                        <span class="fw-bold text-success">@Model.ProgressPercentage%</span>
                    </div>
                    <div class="progress" style="height:20px; border-radius:10px;">
                        <div class="progress-bar bg-success progress-bar-striped progress-bar-animated"
                             role="progressbar"
                             style="width:@Model.ProgressPercentage%;"
                             aria-valuenow="@Model.ProgressPercentage" aria-valuemin="0" aria-valuemax="100">
                            @if (Model.ProgressPercentage > 10)
                            {
                                <span>@Model.ProgressPercentage%</span>
                            }
                        </div>
                    </div>
                    <div class="d-flex justify-content-between mt-1 small text-muted">
                        <span>Current: @Model.CurrentValue</span>
                        <span>Target: @Model.TargetValue</span>
                    </div>
                </div>

                <div class="row g-3">
                    <div class="col-sm-6">
                        <div class="p-3 bg-light rounded">
                            <div class="text-muted small">Goal Type</div>
                            <div class="fw-semibold"><span class="badge bg-secondary fs-6">@Model.GoalType</span></div>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="p-3 bg-light rounded">
                            <div class="text-muted small">Status</div>
                            <div><span class="badge @Model.StatusBadgeClass fs-6">@Model.Status</span></div>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="p-3 bg-light rounded">
                            <div class="text-muted small">Start Date</div>
                            <div class="fw-semibold">@Model.StartDate.ToString("MMMM dd, yyyy")</div>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="p-3 bg-light rounded">
                            <div class="text-muted small">Target Date</div>
                            <div class="fw-semibold">@Model.TargetDate.ToString("MMMM dd, yyyy")</div>
                        </div>
                    </div>
                    @if (!string.IsNullOrEmpty(Model.Notes))
                    {
                        <div class="col-12">
                            <div class="p-3 bg-light rounded">
                                <div class="text-muted small">Notes</div>
                                <div>@Model.Notes</div>
                            </div>
                        </div>
                    }
                </div>
            </div>
            <div class="card-footer bg-transparent d-flex gap-2">
                <a asp-action="Edit" asp-route-id="@Model.FitnessGoalId" class="btn btn-primary">Edit</a>
                <a asp-action="Delete" asp-route-id="@Model.FitnessGoalId" class="btn btn-outline-danger">Delete</a>
                <a asp-action="Index" class="btn btn-outline-secondary ms-auto">← Back</a>
            </div>
        </div>
    </div>
</div>
