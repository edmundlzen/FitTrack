@{
    Layout = null;
    ViewData["Title"] = "FitTrack — Train smarter. Track everything.";
}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<title>@ViewData["Title"]</title>
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
<style>
  :root{
    --navy:#0A0F22;
    --navy-2:#10173A;
    --navy-3:#1A1F36;
    --teal:#00BFA5;
    --teal-2:#06D6BC;
    --teal-soft:rgba(0,191,165,.12);
    --orange:#FF6B35;
    --orange-2:#FFB199;
    --ink:#13182B;
    --ink-2:#3B4262;
    --ink-3:#6B7390;
    --ink-4:#9AA2BD;
    --bg:#F4F6FA;
    --line:#E6E9F2;
    --line-2:#EEF1F7;
    --radius:8px;
    --radius-lg:16px;
  }
  *{box-sizing:border-box}
  html,body{margin:0;padding:0;background:#fff;color:var(--ink);
    font-family:'Inter',ui-sans-serif,system-ui,-apple-system,sans-serif;
    font-feature-settings:'cv11','ss01','ss03';-webkit-font-smoothing:antialiased}
  a{color:inherit;text-decoration:none}
  button{font-family:inherit;cursor:pointer}
  img{display:block;max-width:100%}
  .mono{font-family:'JetBrains Mono',ui-monospace,monospace}
  .wrap{max-width:1240px;margin:0 auto;padding:0 32px}
  @@media (max-width:720px){.wrap{padding:0 20px}}
  .btn{display:inline-flex;align-items:center;gap:8px;padding:13px 20px;border-radius:10px;
    font-weight:600;font-size:14.5px;border:1px solid transparent;transition:transform .06s cubic-bezier(0.4,0,0.2,1),background .18s cubic-bezier(0.4,0,0.2,1),border-color .18s cubic-bezier(0.4,0,0.2,1),box-shadow .18s cubic-bezier(0.4,0,0.2,1);letter-spacing:-.005em}
  .btn:active{transform:translateY(1px)}
  .btn-primary{background:var(--teal);color:#fff}
  .btn-primary:hover{background:#00A892}
  .btn-ghost-dark{background:rgba(255,255,255,.08);color:#fff;border-color:rgba(255,255,255,.16);backdrop-filter:blur(8px)}
  .btn-ghost-dark:hover{background:rgba(255,255,255,.14)}
  .btn-ghost{background:#fff;color:var(--ink);border-color:var(--line)}
  .btn-ghost:hover{background:var(--bg)}
  .btn-lg{padding:15px 24px;font-size:15.5px;border-radius:12px}
  .nav{position:fixed;top:0;left:0;right:0;z-index:50;
    background:rgba(10,15,34,.6);backdrop-filter:blur(20px) saturate(160%);
    border-bottom:1px solid rgba(255,255,255,.06);color:#fff;height:64px;display:flex;align-items:center;
    transition:background .2s cubic-bezier(0.4,0,0.2,1)}
  .nav .wrap{display:flex;align-items:center;width:100%;gap:32px}
  .brand{display:flex;align-items:center;gap:10px}
  .brand-mark{width:32px;height:32px;border-radius:9px;background:linear-gradient(135deg,var(--teal),var(--teal-2));
    display:grid;place-items:center;color:#0A1024;box-shadow:0 6px 20px rgba(0,191,165,.4)}
  .brand-name{font-weight:700;font-size:17px;letter-spacing:-.01em}
  .nav-links{display:flex;gap:28px;margin-left:24px}
  .nav-links a{font-size:13.5px;color:#B7BFE0;font-weight:500;transition:color .18s cubic-bezier(0.4,0,0.2,1)}
  .nav-links a:hover{color:#fff}
  .nav-cta{margin-left:auto;display:flex;align-items:center;gap:10px}
  .nav-login{font-size:13.5px;color:#B7BFE0;font-weight:500}
  .nav-login:hover{color:#fff}
  @@media (max-width:840px){.nav-links{display:none}}
  .hero{position:relative;background:radial-gradient(900px 600px at 80% 10%,rgba(0,191,165,.28),transparent 60%),
    radial-gradient(700px 500px at 10% 90%,rgba(255,107,53,.22),transparent 60%),
    linear-gradient(180deg,var(--navy-2) 0%,var(--navy) 100%);
    color:#fff;padding:160px 0 100px;overflow:hidden}
  .hero::before{content:"";position:absolute;inset:0;
    background-image:linear-gradient(rgba(255,255,255,.025) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.025) 1px,transparent 1px);
    background-size:48px 48px;mask-image:radial-gradient(ellipse 80% 80% at 50% 50%,#000 50%,transparent 100%);
    -webkit-mask-image:radial-gradient(ellipse 80% 80% at 50% 50%,#000 50%,transparent 100%);pointer-events:none}
  .hero .wrap{position:relative;display:grid;grid-template-columns:1.05fr 1fr;gap:60px;align-items:center}
  @@media (max-width:980px){.hero .wrap{grid-template-columns:1fr}}
  .eyebrow{display:inline-flex;align-items:center;gap:10px;padding:6px 12px;border-radius:999px;
    background:rgba(0,191,165,.12);color:var(--teal);border:1px solid rgba(0,191,165,.25);
    font-size:12px;font-weight:600;letter-spacing:.02em}
  .eyebrow .dot{width:6px;height:6px;border-radius:50%;background:var(--teal);box-shadow:0 0 0 4px rgba(0,191,165,.2)}
  .hero h1{font-size:clamp(40px,5.5vw,72px);font-weight:800;line-height:1.02;letter-spacing:-.035em;margin:18px 0 22px;text-wrap:balance}
  .hero h1 .accent{background:linear-gradient(135deg,var(--teal) 0%,var(--teal-2) 100%);
    -webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;color:transparent;
    position:relative;display:inline-block}
  .hero p.lede{font-size:18px;line-height:1.55;color:#B7BFE0;max-width:520px;margin:0 0 32px}
  .hero-cta{display:flex;gap:12px;flex-wrap:wrap;align-items:center}
  .hero-meta{display:flex;gap:24px;margin-top:36px;flex-wrap:wrap}
  .hero-meta .m{display:flex;flex-direction:column;gap:2px}
  .hero-meta .m b{font-size:22px;font-weight:700;letter-spacing:-.02em}
  .hero-meta .m span{font-size:11.5px;color:#8089B0;text-transform:uppercase;letter-spacing:.1em;font-weight:600}
  .stack{display:flex;align-items:center;gap:8px;margin-top:24px}
  .stack .av{width:30px;height:30px;border-radius:50%;border:2px solid var(--navy-2);
    display:grid;place-items:center;font-size:11px;font-weight:700;color:#0A1024;margin-left:-10px}
  .stack .av:first-child{margin-left:0}
  .stack-text{font-size:12.5px;color:#8089B0;margin-left:6px}
  .stack-text b{color:#fff}
  .hero-vis{position:relative;height:560px}
  .hero-vis .mock{position:absolute;border-radius:20px;overflow:hidden;
    box-shadow:0 30px 80px rgba(0,0,0,.5),0 0 0 1px rgba(255,255,255,.04);background:#fff}
  .hero-vis .mock-1{top:0;left:0;width:88%;aspect-ratio:16/11;transform:rotate(-2deg)}
  .hero-vis .mock-2{bottom:0;right:0;width:220px;border-radius:36px;padding:8px;background:#0A0F22;transform:rotate(4deg)}
  .hero-vis .mock-2 .scr{background:#F4F6FA;border-radius:28px;aspect-ratio:9/19;padding:14px;overflow:hidden;position:relative}
  .float{animation:float 6s ease-in-out infinite}
  .float-2{animation:float 7s ease-in-out infinite reverse;animation-delay:-2s}
  @@keyframes float{0%,100%{transform:translateY(0) rotate(var(--r,0))}50%{transform:translateY(-10px) rotate(var(--r,0))}}
  section{padding:120px 0;position:relative}
  @@media (max-width:720px){section{padding:80px 0}}
  .section-eyebrow{display:inline-block;font-size:12px;font-weight:700;color:var(--teal);
    text-transform:uppercase;letter-spacing:.16em;margin-bottom:14px}
  .section-h{font-size:clamp(32px,4vw,52px);font-weight:800;line-height:1.05;letter-spacing:-.025em;text-wrap:balance;margin:0 0 18px}
  .section-sub{font-size:17px;color:var(--ink-3);line-height:1.55;max-width:620px;margin:0}
  .center{text-align:center}
  .center .section-sub{margin-left:auto;margin-right:auto}
  .logos{padding:48px 0;background:#fff;border-bottom:1px solid var(--line)}
  .logos-grid{display:flex;justify-content:space-between;align-items:center;gap:32px;flex-wrap:wrap}
  .logos-grid .lbl{font-size:12px;color:var(--ink-3);font-weight:600;letter-spacing:.1em;text-transform:uppercase}
  .logos-grid .row{display:flex;gap:40px;align-items:center;flex-wrap:wrap;opacity:.7}
  .logos-grid .logo{font-weight:700;font-size:18px;color:var(--ink-2);letter-spacing:-.02em;display:flex;align-items:center;gap:8px}
  .feat-bg{background:linear-gradient(180deg,#fff 0%,var(--bg) 100%)}
  .feat-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-top:64px}
  @@media (max-width:900px){.feat-grid{grid-template-columns:1fr 1fr}}
  @@media (max-width:600px){.feat-grid{grid-template-columns:1fr}}
  .feat{background:#fff;border:1px solid var(--line);border-radius:16px;padding:28px;display:flex;flex-direction:column;gap:14px;
    transition:transform .2s cubic-bezier(0.4,0,0.2,1),box-shadow .2s cubic-bezier(0.4,0,0.2,1),border-color .2s cubic-bezier(0.4,0,0.2,1)}
  .feat:hover{transform:translateY(-3px);box-shadow:0 12px 40px rgba(20,24,48,.08);border-color:#D7DBEA}
  .feat .ico{width:48px;height:48px;border-radius:12px;display:grid;place-items:center;color:#fff;background:linear-gradient(135deg,var(--teal),var(--teal-2));box-shadow:0 8px 20px rgba(0,191,165,.3)}
  .feat.orange .ico{background:linear-gradient(135deg,var(--orange),#FF9F76);box-shadow:0 8px 20px rgba(255,107,53,.3)}
  .feat.navy .ico{background:linear-gradient(135deg,var(--navy-3),#3B4262);box-shadow:0 8px 20px rgba(20,24,48,.25)}
  .feat.purple .ico{background:linear-gradient(135deg,#8B5CF6,#A78BFA);box-shadow:0 8px 20px rgba(139,92,246,.3)}
  .feat.blue .ico{background:linear-gradient(135deg,#3B82F6,#60A5FA);box-shadow:0 8px 20px rgba(59,130,246,.3)}
  .feat.warm .ico{background:linear-gradient(135deg,#F59E0B,#FCD34D);box-shadow:0 8px 20px rgba(245,158,11,.3)}
  .feat h3{font-size:18px;font-weight:700;letter-spacing:-.01em;margin:8px 0 4px}
  .feat p{font-size:14px;line-height:1.55;color:var(--ink-3);margin:0}
  .showcase{background:var(--navy);color:#fff;border-radius:32px;padding:64px 0;margin:120px 0;position:relative;overflow:hidden}
  .showcase::before{content:"";position:absolute;inset:0;
    background:radial-gradient(800px 500px at 50% 0%,rgba(0,191,165,.2),transparent 60%);pointer-events:none}
  .showcase .wrap{position:relative;display:grid;grid-template-columns:1fr;gap:48px;text-align:center}
  .showcase .preview{margin-top:48px;border-radius:16px;overflow:hidden;
    box-shadow:0 40px 120px rgba(0,0,0,.5),0 0 0 1px rgba(255,255,255,.06);background:#fff;color:var(--ink);text-align:left}
  .split{display:grid;grid-template-columns:1fr 1fr;gap:64px;align-items:center}
  @@media (max-width:900px){.split{grid-template-columns:1fr;gap:40px}}
  .split-img{aspect-ratio:4/3;border-radius:20px;background:#0A0F22;overflow:hidden;position:relative;
    box-shadow:0 20px 60px rgba(20,24,48,.15)}
  .mob-stage{display:flex;justify-content:center;gap:24px;margin-top:64px;flex-wrap:wrap}
  .phone{width:270px;height:540px;background:#0A0F22;border-radius:36px;padding:8px;position:relative;
    box-shadow:0 30px 80px rgba(20,24,48,.18),0 0 0 1px rgba(255,255,255,.04) inset}
  .phone .notch{position:absolute;top:14px;left:50%;transform:translateX(-50%);width:80px;height:22px;background:#0A0F22;border-radius:12px;z-index:3}
  .phone .scr{width:100%;height:100%;background:#F4F6FA;border-radius:28px;overflow:hidden;position:relative;display:flex;flex-direction:column}
  .stats-band{background:linear-gradient(135deg,var(--navy-2) 0%,var(--navy) 100%);color:#fff;border-radius:24px;padding:56px;position:relative;overflow:hidden}
  .stats-band::before{content:"";position:absolute;inset:0;
    background:radial-gradient(400px 240px at 90% 50%,rgba(0,191,165,.25),transparent 60%),radial-gradient(400px 240px at 10% 50%,rgba(255,107,53,.18),transparent 60%);pointer-events:none}
  .stats-grid{position:relative;display:grid;grid-template-columns:repeat(4,1fr);gap:28px}
  @@media (max-width:780px){.stats-grid{grid-template-columns:1fr 1fr}}
  .stat-big .n{font-size:54px;font-weight:800;letter-spacing:-.03em;line-height:1;
    background:linear-gradient(135deg,#fff 0%,#B7BFE0 100%);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent}
  .stat-big .l{font-size:13px;color:#8089B0;margin-top:8px;text-transform:uppercase;letter-spacing:.1em;font-weight:600}
  .test-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-top:56px}
  @@media (max-width:900px){.test-grid{grid-template-columns:1fr}}
  .test{background:#fff;border:1px solid var(--line);border-radius:16px;padding:28px;display:flex;flex-direction:column;gap:16px}
  .test p{font-size:15px;line-height:1.55;color:var(--ink);margin:0;letter-spacing:-.005em}
  .test .who{display:flex;align-items:center;gap:12px;padding-top:8px;border-top:1px solid var(--line-2)}
  .test .who .av{width:38px;height:38px;border-radius:50%;display:grid;place-items:center;color:#fff;font-weight:700;font-size:13px}
  .test .who .name{font-weight:700;font-size:14px}
  .test .who .role{font-size:12px;color:var(--ink-3)}
  .stars{display:flex;gap:2px;color:#F59E0B}
.faq{display:flex;flex-direction:column;gap:8px;max-width:780px;margin:56px auto 0}
  .faq details{background:#fff;border:1px solid var(--line);border-radius:12px;padding:0;overflow:hidden}
  .faq summary{padding:20px 24px;display:flex;justify-content:space-between;align-items:center;cursor:pointer;font-size:16px;font-weight:600;letter-spacing:-.005em;list-style:none}
  .faq summary::-webkit-details-marker{display:none}
  .faq summary::after{content:"";width:11px;height:11px;border-right:2px solid var(--ink-3);border-bottom:2px solid var(--ink-3);transform:rotate(45deg);transition:transform .2s}
  .faq details[open] summary::after{transform:rotate(-135deg)}
  .faq details[open]{border-color:#D7DBEA;box-shadow:0 6px 20px rgba(20,24,48,.05)}
  .faq .ans{padding:0 24px 22px;font-size:14.5px;line-height:1.6;color:var(--ink-3)}
  .cta-band{background:linear-gradient(135deg,var(--navy-2) 0%,var(--navy) 60%,#3B2A1A 100%);color:#fff;border-radius:24px;padding:72px 56px;text-align:center;position:relative;overflow:hidden}
  .cta-band::before{content:"";position:absolute;inset:0;
    background:radial-gradient(500px 300px at 30% 30%,rgba(0,191,165,.3),transparent 60%),radial-gradient(500px 300px at 80% 80%,rgba(255,107,53,.3),transparent 60%);pointer-events:none}
  .cta-band > *{position:relative}
  .cta-band h2{font-size:clamp(32px,4.5vw,52px);font-weight:800;letter-spacing:-.025em;line-height:1.05;margin:0 0 16px;text-wrap:balance}
  .cta-band p{font-size:17px;color:#B7BFE0;max-width:560px;margin:0 auto 32px;line-height:1.55}
  footer{background:#fff;border-top:1px solid var(--line);padding:64px 0 40px;color:var(--ink-2)}
  .foot-grid{display:grid;grid-template-columns:1.5fr 1fr 1fr 1fr 1fr;gap:32px;margin-bottom:48px}
  @@media (max-width:900px){.foot-grid{grid-template-columns:1fr 1fr;gap:32px}}
  .foot-col h4{font-size:12px;font-weight:700;color:var(--ink);text-transform:uppercase;letter-spacing:.12em;margin:0 0 16px}
  .foot-col a{display:block;font-size:13.5px;color:var(--ink-3);padding:5px 0;transition:color .18s cubic-bezier(0.4,0,0.2,1)}
  .foot-col a:hover{color:var(--teal)}
  .foot-col p{font-size:13.5px;color:var(--ink-3);line-height:1.55;margin:14px 0}
  .foot-bot{display:flex;justify-content:space-between;padding-top:24px;border-top:1px solid var(--line);font-size:12.5px;color:var(--ink-3);flex-wrap:wrap;gap:14px}
  .ui-row{display:flex;justify-content:space-between;align-items:center;padding:6px 0;font-size:11px}
  .badge-mini{padding:2px 7px;border-radius:999px;background:var(--teal-soft);color:#007E6C;font-size:9.5px;font-weight:600}
  .reveal{opacity:0;transform:translateY(20px);transition:opacity .6s cubic-bezier(0.4,0,0.2,1),transform .6s cubic-bezier(0.4,0,0.2,1)}
  .reveal.in{opacity:1;transform:none}
</style>
</head>
<body>

<!-- Nav -->
<header class="nav" id="nav">
  <div class="wrap">
    <a href="#" class="brand">
      <div class="brand-mark">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M6.5 6.5v11M3 9v6M17.5 6.5v11M21 9v6M6.5 12h11"/></svg>
      </div>
      <span class="brand-name">FitTrack</span>
    </a>
    <nav class="nav-links">
      <a href="#features">Features</a>
      <a href="#mobile">Mobile</a>
      <a href="#faq">FAQ</a>
    </nav>
    <div class="nav-cta">
      <a href="/Identity/Account/Login" class="nav-login">Log in</a>
      <a href="/Identity/Account/Register" class="btn btn-primary" style="padding:9px 16px;font-size:13.5px">Start free</a>
    </div>
  </div>
</header>

<!-- Hero -->
<section class="hero">
  <div class="wrap">
    <div>
<h1>Train smarter.<br/><span class="accent">Track everything.</span></h1>
      <p class="lede">FitTrack is the all-in-one habit engine for athletes who actually log it. Workouts, macros, body metrics, goals — one dashboard, zero spreadsheets.</p>
      <div class="hero-cta">
        <a href="/Identity/Account/Register" class="btn btn-primary btn-lg">
          Start free — no card
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
        <a href="#showcase" class="btn btn-ghost-dark btn-lg">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M6 4l14 8-14 8z"/></svg>
          See the dashboard
        </a>
      </div>
      <div class="stack">
        <div class="av" style="background:linear-gradient(135deg,#FF6B35,#FFB199)">AR</div>
        <div class="av" style="background:linear-gradient(135deg,#00BFA5,#06D6BC)">JM</div>
        <div class="av" style="background:linear-gradient(135deg,#8B5CF6,#A78BFA)">KS</div>
        <div class="av" style="background:linear-gradient(135deg,#3B82F6,#60A5FA)">TN</div>
        <div class="av" style="background:linear-gradient(135deg,#F59E0B,#FCD34D)">LV</div>
        <span class="stack-text"><b>48,200+ athletes</b> training this week</span>
      </div>
      <div class="hero-meta">
        <div class="m"><b>4.9★</b><span>App Store · 12k reviews</span></div>
        <div class="m"><b>2.1M</b><span>Workouts logged</span></div>
        <div class="m"><b>97%</b><span>Stick past day 30</span></div>
      </div>
    </div>
    <div class="hero-vis">
      <div class="mock mock-1 float" style="--r:-2deg">
        <div style="background:#1A1F36;color:#fff;padding:14px 18px;display:flex;align-items:center;gap:10px;font-size:12px">
          <div style="width:20px;height:20px;border-radius:5px;background:linear-gradient(135deg,#00BFA5,#06D6BC)"></div>
          <span style="font-weight:700">FitTrack</span>
          <span style="color:#8089B0;margin-left:auto">Dashboard</span>
        </div>
        <div style="padding:18px;display:grid;grid-template-columns:1fr 1fr 1fr 1fr;gap:10px">
          <div style="background:#F4F6FA;border-radius:10px;padding:12px"><div style="font-size:9px;color:#6B7390;font-weight:600;text-transform:uppercase;letter-spacing:.06em">Workouts</div><div style="font-size:22px;font-weight:800;letter-spacing:-.02em;margin-top:4px">92</div><div style="font-size:10px;color:#22C55E;font-weight:600;margin-top:2px">↑ +8</div></div>
          <div style="background:#F4F6FA;border-radius:10px;padding:12px"><div style="font-size:9px;color:#6B7390;font-weight:600;text-transform:uppercase;letter-spacing:.06em">Calories</div><div style="font-size:22px;font-weight:800;letter-spacing:-.02em;margin-top:4px">2,300</div><div style="font-size:10px;color:#6B7390;margin-top:2px">/2,200 goal</div></div>
          <div style="background:#F4F6FA;border-radius:10px;padding:12px"><div style="font-size:9px;color:#6B7390;font-weight:600;text-transform:uppercase;letter-spacing:.06em">Goals</div><div style="font-size:22px;font-weight:800;letter-spacing:-.02em;margin-top:4px">3</div><div style="font-size:10px;color:#6B7390;margin-top:2px">1 due soon</div></div>
          <div style="background:#F4F6FA;border-radius:10px;padding:12px"><div style="font-size:9px;color:#6B7390;font-weight:600;text-transform:uppercase;letter-spacing:.06em">Weight</div><div style="font-size:22px;font-weight:800;letter-spacing:-.02em;margin-top:4px">76.4</div><div style="font-size:10px;color:#EF4444;font-weight:600;margin-top:2px">↓ −1.6kg</div></div>
        </div>
        <div style="padding:0 18px 18px;display:grid;grid-template-columns:1.6fr 1fr;gap:12px">
