@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthProvider

<div class="ft-app-mobile">
    <div class="ft-status-bar"></div>
    <header class="ft-topbar-mobile">
        <div class="ft-brand-mark">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M6.5 6.5v11M3 9v6M17.5 6.5v11M21 9v6M6.5 12h11"/>
            </svg>
        </div>
        <span class="ft-brand-name">FitTrack</span>
    </header>

    <main class="ft-content-mobile">
        @Body
    </main>

    @if (_isAuthenticated)
    {
        <NavMenu />
    }
</div>

@code {
    private bool _isAuthenticated;

    protected override async Task OnInitializedAsync()
    {
        AuthProvider.AuthenticationStateChanged += OnAuthStateChanged;
        var state = await AuthProvider.GetAuthenticationStateAsync();
        _isAuthenticated = state.User.Identity?.IsAuthenticated == true;
    }

    private async void OnAuthStateChanged(Task<AuthenticationState> task)
    {
        var state = await task;
        _isAuthenticated = state.User.Identity?.IsAuthenticated == true;
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        AuthProvider.AuthenticationStateChanged -= OnAuthStateChanged;
    }
}
