@page "/login"
@using FitTrack.Maui.Services
@inject ApiClient Api
@inject FitTrackAuthStateProvider AuthProvider
@inject NavigationManager Nav

<div class="container d-flex justify-content-center align-items-center" style="min-height: 80vh;">
    <div class="card shadow" style="width: 100%; max-width: 400px;">
        <div class="card-body p-4">
            <div class="text-center mb-4">
                <h2 class="fw-bold text-primary">FitTrack</h2>
                <p class="text-muted">Sign in to continue</p>
            </div>

            @if (!string.IsNullOrEmpty(_initError))
            {
                <div class="alert alert-danger">
                    <strong>Startup Error:</strong>
                    <pre class="mb-0 small">@_initError</pre>
                </div>
            }

            @if (!string.IsNullOrEmpty(_error))
            {
                <div class="alert alert-danger">
                    <strong>Error:</strong>
                    <pre class="mb-0 small">@_error</pre>
                </div>
            }

            <EditForm Model="_model" OnValidSubmit="HandleLogin">
                <DataAnnotationsValidator />
                <div class="mb-3">
                    <label class="form-label">Email</label>
                    <InputText @bind-Value="_model.Email" class="form-control" placeholder="email@example.com" />
                    <ValidationMessage For="() => _model.Email" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Password</label>
                    <InputText @bind-Value="_model.Password" type="password" class="form-control" placeholder="Password" />
                    <ValidationMessage For="() => _model.Password" />
                </div>
                <button type="submit" class="btn btn-primary w-100" disabled="@_loading">
                    @if (_loading)
                    {
                        <span class="spinner-border spinner-border-sm me-2"></span>
                    }
                    Sign In
                </button>
            </EditForm>

            <div class="text-center mt-3">
            </div>
        </div>
    </div>
</div>

@code {
    private LoginModel _model = new();
    private string? _error;
    private string? _initError;
    private bool _loading;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            if (AuthState != null)
            {
                var state = await AuthState;
                if (state.User.Identity?.IsAuthenticated == true)
                    Nav.NavigateTo("/dashboard");
            }
        }
        catch (Exception ex)
        {
            _initError = $"Init: {ex.GetType().Name}: {ex.Message}";
        }
    }

    private async Task HandleLogin()
    {
        _loading = true;
        _error = null;
        try
        {
            var result = await Api.LoginAsync(_model.Email, _model.Password);
            if (result == null)
            {
                _error = "Login failed: API returned null. Check connectivity or credentials.";
                return;
            }
            await AuthProvider.NotifyUserAuthenticated(result.Token);
            Nav.NavigateTo("/dashboard");
        }
        catch (Exception ex)
        {
            _error = $"Login error: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private class LoginModel
    {
        [System.ComponentModel.DataAnnotations.Required]
        [System.ComponentModel.DataAnnotations.EmailAddress]
        public string Email { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required]
        public string Password { get; set; } = string.Empty;
    }
}
